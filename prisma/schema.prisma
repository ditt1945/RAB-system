generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

// ─── Enum ────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  estimator
}

enum ProjectStatus {
  planning
  progress
  completed
  cancelled
}

/// Jenis sumber daya pada AHSP
enum ResourceType {
  upah
  bahan
  alat
}

enum AiRequestStatus {
  processing
  completed
  failed
}

// ─── Pengguna ────────────────────────────────────────────────────────────

model User {
  id              BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name            String           @db.VarChar(255)
  email           String           @unique @db.VarChar(255)
  password        String           @db.VarChar(255)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  profileSettings ProfileSetting?
  companySettings CompanySettings?
  projects        Project[]
  aiRequests      AiRequest[]

  @@map("users")
}

model ProfileSetting {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId      BigInt   @unique @map("user_id") @db.UnsignedBigInt
  role        UserRole @default(estimator)
  phoneNumber String?  @map("phone_number") @db.VarChar(20)
  department  String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profile_settings")
}

/// Identitas perusahaan untuk kop laporan RAB
model CompanySettings {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ownerId     BigInt   @unique @map("owner_id") @db.UnsignedBigInt
  companyName String   @map("company_name") @db.VarChar(255)
  address     String   @db.Text
  phone       String?  @db.VarChar(20)
  email       String?  @db.VarChar(255)
  logoUrl     String?  @map("logo_url") @db.VarChar(512)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  user        User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("company_settings")
}

// ─── Master AHSP (Analisa Harga Satuan Pekerjaan) ────────────────────────

/// Harga dasar upah, bahan, dan alat
model Resource {
  id            BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  code          String          @unique @db.VarChar(20)
  name          String          @db.VarChar(255)
  type          ResourceType
  unit          String          @db.VarChar(50)
  unitPrice     Decimal         @default(0) @map("unit_price") @db.Decimal(15, 2)
  source        String?         @db.VarChar(255)
  effectiveDate DateTime?       @map("effective_date") @db.Date
  isActive      Boolean         @default(true) @map("is_active")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")
  components    AhspComponent[]

  @@index([type, name])
  @@map("resources")
}

model AhspCategory {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  code      String   @unique @db.VarChar(20)
  name      String   @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ahsp      Ahsp[]

  @@map("ahsp_categories")
}

/// Analisa pekerjaan, mis. "Galian 1 m3 tanah biasa"
model Ahsp {
  id              BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  categoryId      BigInt          @map("category_id") @db.UnsignedBigInt
  code            String          @unique @db.VarChar(30)
  name            String          @db.VarChar(255)
  unit            String          @db.VarChar(50)
  overheadPercent Decimal         @default(10) @map("overhead_percent") @db.Decimal(5, 2)
  description     String?         @db.Text
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  category        AhspCategory    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  components      AhspComponent[]
  rabItems        RabItem[]

  @@index([categoryId, isActive])
  @@map("ahsp")
}

/// Koefisien sumber daya dalam satu AHSP
model AhspComponent {
  id          BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  ahspId      BigInt   @map("ahsp_id") @db.UnsignedBigInt
  resourceId  BigInt   @map("resource_id") @db.UnsignedBigInt
  coefficient Decimal  @db.Decimal(12, 6)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  ahsp        Ahsp     @relation(fields: [ahspId], references: [id], onDelete: Cascade)
  resource    Resource @relation(fields: [resourceId], references: [id], onDelete: Restrict)

  @@unique([ahspId, resourceId])
  @@map("ahsp_components")
}

// ─── Proyek & RAB ────────────────────────────────────────────────────────

model Project {
  id                  BigInt        @id @default(autoincrement()) @db.UnsignedBigInt
  createdBy           BigInt        @map("created_by") @db.UnsignedBigInt
  projectName         String        @map("project_name") @db.VarChar(255)
  clientName          String        @map("client_name") @db.VarChar(255)
  location            String?       @db.VarChar(255)
  description         String?       @db.Text
  startDate           DateTime?     @map("start_date") @db.Date
  endDate             DateTime?     @map("end_date") @db.Date
  status              ProjectStatus @default(planning)
  rabDiscount         Decimal       @default(0) @map("rab_discount") @db.Decimal(15, 2)
  rabServiceFee       Decimal       @default(0) @map("rab_service_fee") @db.Decimal(15, 2)
  targetMarginPercent Decimal       @default(0) @map("target_margin_percent") @db.Decimal(5, 2)
  rabTaxPercent       Decimal       @default(11) @map("rab_tax_percent") @db.Decimal(5, 2)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  creator             User          @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  rabItems            RabItem[]
  aiRequests          AiRequest[]

  @@index([createdBy, status])
  @@map("projects")
}

/// Baris RAB. ahspId null = item manual. unitPrice adalah snapshot harga saat item dibuat.
model RabItem {
  id        BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  projectId BigInt   @map("project_id") @db.UnsignedBigInt
  ahspId    BigInt?  @map("ahsp_id") @db.UnsignedBigInt
  groupName String   @default("Lain-lain") @map("group_name") @db.VarChar(255)
  code      String?  @db.VarChar(30)
  name      String   @db.VarChar(255)
  unit      String   @db.VarChar(50)
  volume    Decimal  @default(0) @db.Decimal(15, 3)
  unitPrice Decimal  @default(0) @map("unit_price") @db.Decimal(15, 2)
  subtotal  Decimal  @default(0) @db.Decimal(17, 2)
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ahsp      Ahsp?    @relation(fields: [ahspId], references: [id], onDelete: SetNull)

  @@index([projectId, groupName])
  @@map("rab_items")
}

/// Riwayat permintaan rekomendasi AI
model AiRequest {
  id          BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
  projectId   BigInt          @map("project_id") @db.UnsignedBigInt
  userId      BigInt          @map("user_id") @db.UnsignedBigInt
  prompt      String          @db.Text
  status      AiRequestStatus @default(processing)
  suggestions Json?
  error       String?         @db.Text
  acceptedAt  DateTime?       @map("accepted_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  project     Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@map("ai_requests")
}
